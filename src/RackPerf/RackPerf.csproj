<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RackPerf</AssemblyName>
    <RootNamespace>RackPerf</RootNamespace>
    <Version>1.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Override with:  dotnet build -p:GameDir="D:\path\to\Data Center" -->
    <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Data Center</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
    <Il2Cpp>$(MLDir)\Il2CppAssemblies</Il2Cpp>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">           <HintPath>$(MLDir)\net6\MelonLoader.dll</HintPath></Reference>
    <Reference Include="0Harmony">              <HintPath>$(MLDir)\net6\0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"> <HintPath>$(MLDir)\net6\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib">        <HintPath>$(Il2Cpp)\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp">       <HintPath>$(Il2Cpp)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2Cpp)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Unity.InputSystem">     <HintPath>$(Il2Cpp)\Unity.InputSystem.dll</HintPath></Reference>
    <!-- WaypointInitializationSystem derives from SystemBase -->
    <Reference Include="Unity.Entities">        <HintPath>$(Il2Cpp)\Unity.Entities.dll</HintPath></Reference>
    <Reference Include="Unity.Collections">     <HintPath>$(Il2Cpp)\Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics">     <HintPath>$(Il2Cpp)\Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>

</Project>
